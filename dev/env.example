# Kopieren nach dev/.env (gitignored) und Werte eintragen. Nie committen.

# Linear: OAuth-App (Client-ID und -Secret, siehe README "Linear einrichten")
LINEAR_CLIENT_ID=xxxxxxxx
LINEAR_CLIENT_SECRET=xxxxxxxx
LINEAR_CLIENT_SECRET_REF=env://LINEAR_CLIENT_SECRET
# Linear: Webhook-Secret (optional, nur bei Webhook-Betrieb)
#LINEAR_WEBHOOK_SECRET=xxxxxxxx
#LINEAR_WEBHOOK_SECRET_REF=env://LINEAR_WEBHOOK_SECRET
# Linear: Abfrageintervall des Pollings
LINEAR_POLL_INTERVAL=10s

# GitHub-App: numerische App-ID
GITHUB_APP_ID=123456
# GitHub-App: privater Schlüssel als PEM, mehrzeilig in Anführungszeichen (Secret)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
# GitHub-App: Verweis auf das Secret oben
GITHUB_APP_PRIVATE_KEY_REF=env://GITHUB_APP_PRIVATE_KEY
# GitHub-App: Client-ID und Client-Secret (Secret) für die Verbindung per OAuth
GITHUB_CLIENT_ID=Iv1.xxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxx
GITHUB_CLIENT_SECRET_REF=env://GITHUB_CLIENT_SECRET
# GitHub: API-Basis-URL (nur ändern bei GitHub Enterprise)
GITHUB_API_URL=https://api.github.com

# Claude: genau eines von beiden setzen (Secret)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
#CLAUDE_CODE_OAUTH_TOKEN=xxxxxxxx

# Postgres-Verbindung (passt zu dev/compose.yaml)
DATABASE_URL=postgres://orchivio:orchivio@localhost:5432/orchivio?sslmode=disable

# gRPC-Adressen setzt dev/run-all.sh explizit auf 127.0.0.1 (unverschlüsselt, ohne Auth;
# mTLS vor entfernten Workern). Standard ohne Variable ist ebenfalls 127.0.0.1:
# Server 7070, Linear-Adapter 7101 (Webhook :7102), GitHub-Adapter 7201.

# Schlüssel zum Verschlüsseln der Mandanten-Zugänge (Secret, 32 Byte base64). Erzeugen mit:
#   openssl rand -base64 32
# Ohne ihn startet der Server nicht. Nach dem Setzen nicht mehr ändern (sonst sind gespeicherte Verbindungen unlesbar).
ORCHIVIO_SECRET_KEY=

# Admin-Token für die erste Einrichtung (Secret). Erzeugen mit:
#   echo "orv_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')"
ORCHIVIO_BOOTSTRAP_TOKEN=

# Startwerte für dev/seed.sh (Mandant, Linear-Team-Key, Test-Repo, Rollen-E-Mail, Modell)
ORCHIVIO_SEED_TENANT=acme
ORCHIVIO_SEED_TEAM_KEY=RES
ORCHIVIO_SEED_REPO=soemii/orchivio-playground
ORCHIVIO_SEED_EMAIL=you@example.com
ORCHIVIO_SEED_MODEL=sonnet

# --- Optional: Jira und GitLab (Profil jira-gitlab, siehe README "Live-Test Jira/GitLab") ---
# Starten mit: COMPOSE_PROFILES=jira-gitlab ORCHIVIO_EXTRA_ADAPTERS=,jira-cloud=adapter-jira-cloud:7301,jira-dc=adapter-jira-dc:7302,gitlab=adapter-gitlab:7401 dev/run-all.sh
#COMPOSE_PROFILES=jira-gitlab
#ORCHIVIO_EXTRA_ADAPTERS=,jira-cloud=adapter-jira-cloud:7301,jira-dc=adapter-jira-dc:7302,gitlab=adapter-gitlab:7401
# Basis-URLs der Instanzen (Jira Data Center, GitLab); Jira Cloud braucht keine
#JIRA_URL=https://jira.example.com
#GITLAB_URL=https://gitlab.example.com
# Unternehmens-Proxy und eigene CA (optional)
#HTTPS_PROXY=
#HTTP_PROXY=
#NO_PROXY=
#SSL_CERT_FILE=
#SSL_CERT_DIR=
# Startwerte für den Mandanten beta in dev/seed.sh (nur wenn alle gesetzt sind;
# SITE_URL und EMAIL nur bei jira-cloud, bei jira-dc ignoriert)
#ORCHIVIO_SEED_JIRA_ADAPTER=jira-cloud
#ORCHIVIO_SEED_JIRA_SITE_URL=https://example.atlassian.net
#ORCHIVIO_SEED_JIRA_EMAIL=bot@example.com
#ORCHIVIO_SEED_JIRA_TOKEN=xxxxxxxx
#ORCHIVIO_SEED_JIRA_KEY=ABC
#ORCHIVIO_SEED_GITLAB_PATH=group/project
#ORCHIVIO_SEED_GITLAB_TOKEN=xxxxxxxx
#ORCHIVIO_SEED_GITLAB_REPO=group/project
# Optional: JQL-Filter der Jira-Verbindung
#ORCHIVIO_SEED_JIRA_JQL=project = ABC
# Optional: zusätzliche Rollen für beta als jira:<user> bzw. gitlab:<user>
# (am besten die unveränderliche ID: Jira-accountId bzw. DC-Benutzerschlüssel, GitLab-User-ID)
#ORCHIVIO_SEED_JIRA_USER=
#ORCHIVIO_SEED_GITLAB_USER=
