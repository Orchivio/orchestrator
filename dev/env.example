# Kopieren nach dev/.env (gitignored) und Werte eintragen. Nie committen.

# Linear: persönlicher API-Key des technischen Nutzers "Orchivio" (Secret)
LINEAR_TOKEN_ACME=lin_api_xxxxxxxx
# Linear: Verweis auf das Secret oben
LINEAR_API_KEY_REF=env://LINEAR_TOKEN_ACME
# Linear: Team-Keys, die beobachtet werden (kommagetrennt)
LINEAR_TEAM_KEYS=ORC
# Linear: Webhook-Secret (optional, nur bei Webhook-Betrieb)
#LINEAR_WEBHOOK_SECRET=xxxxxxxx
#LINEAR_WEBHOOK_SECRET_REF=env://LINEAR_WEBHOOK_SECRET
# Linear: Abfrageintervall des Pollings
LINEAR_POLL_INTERVAL=10s

# GitHub-App: numerische App-ID
GITHUB_APP_ID=123456
# GitHub-App: privater Schlüssel als PEM, mehrzeilig in Anführungszeichen (Secret)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"
# GitHub-App: Verweis auf das Secret oben
GITHUB_APP_PRIVATE_KEY_REF=env://GITHUB_APP_PRIVATE_KEY
# GitHub: API-Basis-URL (nur ändern bei GitHub Enterprise)
GITHUB_API_URL=https://api.github.com

# Claude: genau eines von beiden setzen (Secret)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
#CLAUDE_CODE_OAUTH_TOKEN=xxxxxxxx

# Postgres-Verbindung (passt zu dev/compose.yaml)
DATABASE_URL=postgres://orchivio:orchivio@localhost:5432/orchivio?sslmode=disable

# gRPC-Adressen setzt dev/run-all.sh explizit auf 127.0.0.1 (unverschlüsselt, ohne Auth;
# mTLS vor entfernten Workern). Standard ohne Variable ist ebenfalls 127.0.0.1:
# Server 7070, Linear-Adapter 7101 (Webhook :7102), GitHub-Adapter 7201.
